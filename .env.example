# Copy to .env and edit. bin/polaris reads it at start. Every value here is a placeholder.
# Nothing in this file is a secret: Polaris mints its own token in memory at each start.

# Where Polaris keeps questions, commands, pins, answers, feeds and state.
POLARIS_HOME="$HOME/.polaris"

# The checkout new terminals and Run these probes start in.
POLARIS_REPO="$HOME/code/my-project"

# The branch of POLARIS_REPO the Run these checker watches for new commits.
POLARIS_BRANCH="main"

# Checkouts other agents share, separated by ":". A branch switch or stash there is judged destructive.
POLARIS_SHARED="$HOME/code/my-project"

# A path fragment that marks secret files. Any command naming it is judged destructive.
POLARIS_SECRETS_GLOB="secrets."

# Extra relative path prefixes the Run these checker treats as files, separated by ",".
POLARIS_PATH_PREFIXES="config,tools"

# What the Session terminal tab runs.
POLARIS_SESSION_CMD="claude"

# A command that receives a follow-up as JSON on stdin when you answer yes to a question.
# Leave it empty and follow-ups are written to $POLARIS_HOME/queue/ instead.
POLARIS_QUEUE_CMD=""

# Your own data source, as "package.module:ClassName". Empty means plain files (sources.py).
POLARIS_SOURCES=""

# Seconds between Run these checker ticks (0 turns it off). Each tick only acts when due.
POLARIS_CHECK_EVERY=60

# Time zone for "ask me later". Empty means the Mac's own.
POLARIS_TZ="Europe/London"
